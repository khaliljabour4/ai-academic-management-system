# Copy to .env (never commit .env). Used by Spring locally AND by docker compose.
DB_PASSWORD=change-me
# Generate with: openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-string

# First administrator, created at startup if it does not exist (needed because /register is admin-only)
ADMIN_EMAIL=admin@school.ma
ADMIN_PASSWORD=change-me-too

# Optional (local, without Docker)
# DB_URL=jdbc:mysql://localhost:3306/SchoolManagement
# DB_USERNAME=root
# CORS_ALLOWED_ORIGINS=http://localhost:5500
